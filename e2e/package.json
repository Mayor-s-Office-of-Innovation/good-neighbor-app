    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.9.1",
    "@playwright/test": "1.63.0",
    "ramp-check": "github:Mayor-s-Office-of-Innovation/ramp-check#5fee75fe16e71c3748b417abf9818990904aef43",
    "typescript": "5.5.4"
  }
}
