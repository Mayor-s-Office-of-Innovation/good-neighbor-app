{
  "name": "@good-neighbor/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:remote": "API_PROXY_TARGET=https://dev.goodneighborsf.org vite --host 127.0.0.1",
    "lint": "eslint src",
    "perf": "speed-check",
    "size": "size-limit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "size-limit": [
    {
      "name": "main js",
      "path": "dist/assets/index-*.js",
      "limit": "77 kB"
    },
    {
      "name": "site admin js",
      "path": "dist/assets/site-admin-*.js",
      "limit": "9 kB"
    },
    {
      "name": "main css",
      "path": "dist/assets/index-*.css",
      "limit": "21 kB"
    },
    {
      "name": "task update js",
      "path": "dist/assets/task-update-dialog-*.js",
      "limit": "5.5 kB"
    },
    {
      "name": "task update css",
      "path": "dist/assets/task-update-dialog-*.css",
      "limit": "2 kB"
    },
    {
      "name": "site admin css",
      "path": "dist/assets/site-admin-*.css",
      "limit": "2 kB"
    },
    {
      "name": "reports js",
      "path": "dist/assets/reports-view-*.js",
      "limit": "13 kB"
    },
    {
      "name": "reports css",
      "path": "dist/assets/reports-view-*.css",
      "limit": "3 kB"
    }
  ],
  "dependencies": {
    "@awesome.me/webawesome": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "9.9.1",
    "@size-limit/file": "^14.0.0",
    "@types/node": "^22.20.1",
    "eslint": "9.9.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "globals": "15.9.0",
    "size-limit": "^14.0.0",
    "speed-check": "github:Mayor-s-Office-of-Innovation/speed-check#d472e8682b2e76504627f446e6881275bddfefd9",
    "typescript": "5.5.4",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.11"
  }
}
