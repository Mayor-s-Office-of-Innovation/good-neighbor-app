# Local dev harness environment.
# Copy to .env.local (git-ignored) and adjust if you change ports/names.
# Loaded by the local:* npm scripts via Node's native --env-file=.env.local.
#
# Values here are dummies for the Docker-free local harness (DynamoDB Local +
# ElasticMQ). getConfig() only checks these are present, and the local jars do
# not validate AWS credentials — so nothing here is a real secret.

# --- Remote analyzer (the analyze worker calls the DEPLOYED service) ---
# CROSS-REF: the full local loop (npm run dev -w backend) reads ANALYZER_* from
# THIS file (.env.local), NOT backend/.env. backend/.env feeds only
# `npm run analyze:smoke`. To exercise both paths, set the key in both files.
# The worker reads media from MinIO, then calls this real cloud service with an
# API key. ANALYZER_API_KEY is a real secret — leave it blank here and set it
# only in your git-ignored .env.local. Without it the analyze worker throws and
# the message redelivers (the upload/presign legs still work).


# --- App config contract (backend/src/config.js) ---
DYNAMO_TABLE=gnp-local-app
SQS_QUEUE_URL=http://localhost:9324/000000000000/gnp-local-submissions
S3_UPLOAD_BUCKET=gnp-local-uploads
BEDROCK_MODEL_ID=local-stub-model

# --- AWS SDK v3: redirect DynamoDB/SQS/S3 clients at the local emulators ---
# Service-specific endpoint vars take precedence over the global AWS_ENDPOINT_URL
# and leave Bedrock pointing at real AWS (unused locally).
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_ENDPOINT_URL_SQS=http://localhost:9324
# MinIO (local S3, `npm run local:minio`). Setting this also switches s3.js to
# path-style addressing and makes ensureLocalInfra() create the bucket + CORS.
AWS_ENDPOINT_URL_S3=http://localhost:9000

# v3 throws without a region and *some* credentials. These creds double as the
# MinIO root user/password, so they must satisfy MinIO's rules: user >= 3 chars,
# password >= 8 chars (unlike DynamoDB Local / ElasticMQ, which ignore creds).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localdev
AWS_SECRET_ACCESS_KEY=localdevsecret

# --- dynamodb-admin GUI (npm run db:gui) ---
DYNAMO_ENDPOINT=http://localhost:8000

# --- Auth stub: fake Cognito `sub` when no X-Debug-Sub header is sent ---
DEBUG_SUB=local-dev-user

# --- Remote analyzer (the analyze worker calls the DEPLOYED service) ---
# The worker reads media from MinIO, then calls this real cloud service with an
# API key. ANALYZER_API_KEY is a real secret — leave it blank here and set it
# only in your git-ignored .env.local. Without it the analyze worker throws and
# the message redelivers (the upload/presign legs still work).
ANALYZER_BASE_URL=https://analyzer.example.com
ANALYZER_API_KEY=
