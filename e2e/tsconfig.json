{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "tests/**/*.js",
    "helpers/**/*.js",
    "playwright.config.js",
    "status-tests/**/*.js",
    "system-status.config.js",
    "support-tests/**/*.js",
    "support.config.js",
    "task-update-tests/**/*.js",
    "task-updates.config.js"
  ]
}
