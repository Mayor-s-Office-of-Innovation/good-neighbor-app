# Backend environment — copy to backend/.env (gitignored) and fill in real
# values. Loaded via `node --env-file=.env`. Never commit real secrets.

# --- Live analysis service (Street Conditions analyzer) ---------------------
# Used by `npm run analyze:smoke -w backend` to hit the deployed endpoint.
# In deployed environments the key comes from Secrets Manager (Lambda role),
# NOT from this file — the field device never holds it.

# --- Live analysis service (Street Conditions analyzer) ---------------------
# Used by `npm run analyze:smoke -w backend` to hit the deployed endpoint.
# CROSS-REF: this file feeds ONLY analyze:smoke. The full local loop
# (npm run dev -w backend) reads ANALYZER_* from the repo-root .env.local
# instead -- set the key there too for the worker's analyzer leg to fire.
# In deployed environments the key comes from Secrets Manager (Lambda role),
# NOT from this file — the field device never holds it.

ANALYZER_BASE_URL=https://analysis.example.org/
ANALYZER_API_KEY=your-gnp-consumer-api-key
