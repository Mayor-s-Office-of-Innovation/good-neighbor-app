# Local dev harness environment.
# Copy to .env.local (git-ignored) and adjust if you change ports/names.
# Loaded by the local:* npm scripts via Node's native --env-file=.env.local.
#
# Values here are dummies for the Docker-free local harness (DynamoDB Local +
# ElasticMQ). getConfig() only checks these are present, and the local jars do
# not validate AWS credentials — so nothing here is a real secret.

# --- App config contract (backend/src/config.js) ---
DYNAMO_TABLE=gnp-local-app
SQS_QUEUE_URL=http://localhost:9324/000000000000/gnp-local-submissions
S3_UPLOAD_BUCKET=gnp-local-uploads
BEDROCK_MODEL_ID=local-stub-model

# Local API router. Keep this off 3000 so common Docker apps can use that port.
LOCAL_API_PORT=3001

# --- AWS SDK v3: redirect DynamoDB/SQS clients at the local jars ---
# Service-specific endpoint vars take precedence over the global AWS_ENDPOINT_URL
# and leave S3/Bedrock pointing at real AWS (unused locally). The clients are
# built with `{}`, so this is the only lever — no code change.
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_ENDPOINT_URL_SQS=http://localhost:9324

# v3 throws without a region and *some* credentials, even against local jars.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- dynamodb-admin GUI (npm run db:gui) ---
DYNAMO_ENDPOINT=http://localhost:8000

# --- Auth stub: fake Cognito `sub` when no X-Debug-Sub header is sent ---
DEBUG_SUB=local-dev-user
